@startuml Consulta Projetos

skinparam style strictuml
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Mentor/Jurado" as Ator
control "ProjetoController" as ctrl
entity "ProjetoService" as srv
entity "ProjetoRepository" as repo
database "Banco de Dados" as DB

Ator -> ctrl : GET /api/projetos
activate ctrl
ctrl -> srv : listarTodosProjetos()
activate srv
srv -> repo : findAll()
activate repo
repo -> DB : SELECT * FROM projetos ...
activate DB
DB --> repo : Retorna lista de projetos
deactivate DB
repo --> srv : List<Projeto>
deactivate repo
srv --> ctrl : List<ProjetoResponseDTO>
deactivate srv
ctrl --> Ator : 200 OK (Lista de Projetos)
deactivate ctrl
@enduml