@startuml
skinparam style strictuml
skinparam maxMessageSize 150

actor "Organizador (Cliente API)" as org
control "HackathonController" as ctrl
entity "HackathonRepository" as repo
database "Banco de Dados" as db

org -> ctrl : POST /api/hackathons (nome, datas, limite)
activate ctrl

ctrl -> ctrl : Validar regras de negócio (Datas e Limite)

alt Dados Inválidos (ex: data final menor que inicial)
    ctrl --> org : Erro de Validação (400 Bad Request)
else Dados Válidos
    ctrl -> repo : save(hackathon)
    activate repo
    
    repo -> db : INSERT INTO hackathon
    activate db
    db --> repo : Confirmação de persistência
    deactivate db
    
    repo --> ctrl : Hackathon salvo com ID
    deactivate repo
    
    ctrl --> org : Sucesso (201 Created)
end

deactivate ctrl
@enduml